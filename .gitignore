# The ETIM 10.0 archive itself IS committed (ODC-BY 1.0 permits redistribution with
# attribution — see data/etim/ATTRIBUTION.md). Only derived caches are ignored.
data/etim/build/

# Replay cassettes recorded at runtime. They may hold provider material or licensed
# third-party content that nobody has reviewed yet; curated recordings are promoted
# to data/replay/fixtures/ by hand. See backend/skutruth/replay/README.md.
data/replay/runtime/

# Ingested source artifacts. These are third-party manufacturer documents that we may
# read locally but generally may not redistribute; curated, licence-checked artifacts
# are promoted to data/artifacts/fixtures/ by hand. See backend/skutruth/ingest/README.md.
data/artifacts/runtime/

# Unilog organizer challenge data pack. Third-party competition material with no stated
# redistribution grant; read locally, never committed. Derived findings live in research/.
data/unilog_source/
